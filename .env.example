# ─────────────────────────────────────────────
# .env.example — Bu faylni nusxa olib .env yarating
# Haqiqiy qiymatlarni .env da to'ldiring
# ─────────────────────────────────────────────

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# MySQL / TiDB Cloud
DB_ENGINE=django.db.backends.mysql
DB_HOST=your-db-host.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_DATABASE=sys

# CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000
